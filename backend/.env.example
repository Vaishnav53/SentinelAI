# ==========================================
# SentinelAI Backend — Environment Template
# ==========================================

# Core Application Settings
APP_NAME=SentinelAI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Configuration
# Local dev: sqlite:///./storage/sentinelai.db
# Production: postgresql://user:password@hostname:5432/sentinelai
DATABASE_URL=sqlite:///./storage/sentinelai.db

# Ingress & CORS Settings (supports comma-separated origins)
# Set to your Vercel deployment URL in production (e.g. https://your-project.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional alias for FRONTEND_ORIGIN:
# FRONTEND_URL=https://your-project.vercel.app

# Security & Host Injection Protection (supports comma-separated host patterns)
# Required in production: custom secret key and trusted backend host names
SECRET_KEY=placeholder_for_production_secret_key_change_me
TRUSTED_HOSTS=127.0.0.1,localhost
# Optional alias for TRUSTED_HOSTS:
# ALLOWED_HOSTS=backend.example.com,localhost

# Authentication & Cross-Origin Session Cookie Settings
AUTH_SESSION_COOKIE_NAME=sentinel_session
AUTH_SESSION_TTL_HOURS=24
# Set to true in production with HTTPS
AUTH_COOKIE_SECURE=false
# Use lax for same-domain or development; use none for cross-origin (Vercel -> backend)
AUTH_COOKIE_SAMESITE=lax

# Administrator Bootstrap Settings (Optional)
# If provided, an admin user is bootstrapped securely on startup
SENTINEL_ADMIN_USERNAME=dyn4m1t3
SENTINEL_ADMIN_PASSWORD=your_secure_admin_password_here
SENTINEL_ADMIN_EMAIL=admin@sentinel.ai

# AI Copilot Provider (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b

# Persistent Storage Paths (Defaults to workspace directories)
REPORT_STORAGE=./storage/reports
SANDBOX_STORAGE=./decoy_sandbox

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
