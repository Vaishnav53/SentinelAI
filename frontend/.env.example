# ==========================================
# SentinelAI Frontend — Environment Template
# ==========================================

# Local Development (Vite proxies /api to http://127.0.0.1:8000)
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Vercel / Production Deployment:
# Point to your persistent FastAPI backend instance
# VITE_API_BASE_URL=https://your-backend-api.example.com/api
# VITE_WS_BASE_URL=wss://your-backend-api.example.com

VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=ws://127.0.0.1:8000
